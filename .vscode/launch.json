                "-test.v",
                "-db-run-docker",
                "true",
                "-db-image",
                "${input:dbImage}",
                "--db-port", "8080",
                "--interface-version",
                "2"
            ]
        },
        {
            "name": "Run CSE tests to 128MB",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/pit/tests",
            "args": [
                "-test.run",
                "CSE",
                "-test.v",
                "-db-run-docker",
                "true",
                "-db-image",
                "${input:dbImage}",
                "--db-port", "8080",
                "--interface-version",
                "2",
                "--db-memory",
                "134217728"
            ]
        },
        {
